# Copy to the app root as .env:  cp deploy/local/.env.template .env
# Used by "docker run --env-file .env" and can be sourced for the Python option.

# Model profile: cloud = NVIDIA cloud API endpoints
CONFIG_TYPE=cloud

NVIDIA_API_KEY=nvapi-<your-key>
TAVILY_API_KEY=tvly-<your-key>

# Optional suffix for the Dynatrace service name: nat-chat-app-<suffix>
SERVICE_NAME_SUFFIX=

# Tracing: send to an OTel Collector (see deploy/local/otel)
#   Docker option:  http://host.docker.internal:4318
#   Python option:  http://localhost:4318
OTEL_OTLP_ENDPOINT=http://host.docker.internal:4318
# Or disable OTel entirely:
#OTEL_SDK_DISABLED=true
