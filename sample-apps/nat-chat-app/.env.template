# Copy to .env (gitignored):  cp .env.template .env
# Then uncomment the lines for the section you are using. Variables repeat between
# sections, so uncomment only one section at a time.

# =============================================================================
# LOCAL: run the app on your machine / in Docker
# =============================================================================
# Model profile: cloud = NVIDIA cloud API endpoints
#CONFIG_TYPE=cloud
#NVIDIA_API_KEY=<your NVIDIA API key>
#TAVILY_API_KEY=<your Tavily key>
# Optional suffix for the Dynatrace service name: nat-chat-app-<suffix>
#SERVICE_NAME_SUFFIX=
# Guardrail LLM timeout in seconds (fail-open on timeout: input/output passes through)
#GUARDRAIL_TIMEOUT_SECONDS=60
# Set OTEL_OTLP_ENDPOINT to enable tracing, or OTEL_SDK_DISABLED=true to run without monitoring
#OTEL_OTLP_ENDPOINT=http://host.docker.internal:4318
#OTEL_SDK_DISABLED=true
# OTel Collector in Docker (deploy/local/otel/start-otel.sh; token scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest)
#DT_BASE_URL=https://<tenant>.live.dynatrace.com
#DT_API_TOKEN=<your Dynatrace API token>
# Only for config-nim.yaml: host running your own NIM containers
#NIM_HOST=<host IP>

# =============================================================================
# CLOUD: deploy to Kubernetes with the scripts in deploy/k8s
# =============================================================================
# deploy-app.sh
#TAVILY_API_KEY=<your Tavily key>
# otel/deploy-otel-collector.sh (token scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest)
#DT_BASE_URL=https://<tenant>.live.dynatrace.com
#DT_API_TOKEN=<your Dynatrace API token>
# loadgen/loadgen.sh (optional)
#LOADGEN_DELAY_MIN=30
#LOADGEN_DELAY_MAX=90
