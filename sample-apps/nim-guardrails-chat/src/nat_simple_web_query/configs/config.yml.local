# Enable the exporting of traces via OpenTelemetry
general:
  telemetry:
    tracing:
      otelcollector:
        _type: otelcollector
        # The endpoint where you have deployed the otel collector
        endpoint: "${OTEL_OTLP_ENDPOINT:-http://localhost:4318}/v1/traces"
        project: nat_workflow

function_groups:
  internet_search:
    _type: tavily
    include: [search]

functions:
  current_datetime:
    _type: current_datetime

llms:
  nim_llm:
    _type: nim
    model_name: meta/llama-4-scout-17b-16e-instruct
    base_url: http://localhost:8001/v1
    temperature: 0.1

embedders:
  nv-embedqa-e5-v5:
    _type: nim
    model_name: nvidia/nv-embedqa-e5-v5
    base_url: http://localhost:8004/v1

workflow:
  _type: react_agent
  tool_names: [internet_search__search, current_datetime]
  llm_name: nim_llm
  verbose: false
  parse_agent_response_max_retries: 3
