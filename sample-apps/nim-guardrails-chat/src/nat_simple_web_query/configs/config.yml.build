# Enable the exporting of traces via OpenTelemetry
general:
  telemetry:
    tracing:
      otelcollector:
        _type: otelcollector
        # The endpoint where you have deployed the otel collector
        endpoint: "${OTEL_OTLP_ENDPOINT:-http://localhost:4318}/v1/traces"
        project: "nat_workflow${GITHUB_USER:+-${GITHUB_USER}}"

function_groups:
  internet_search:
    _type: tavily
    include: [search]

functions:
  current_datetime:
    _type: current_datetime

llms:
  nim_llm:
    _type: nim
    model_name: google/gemma-4-31b-it
    temperature: 0.1
    max_tokens: 1024

embedders:
  nv-embedqa-e5-v5:
    _type: nim
    model_name: nvidia/nv-embedqa-e5-v5

workflow:
  _type: tool_calling_agent
  tool_names: [internet_search__search, current_datetime]
  llm_name: nim_llm
  verbose: false
